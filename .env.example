# Copier en .env (jamais commité) et remplir. Aucun secret dans le code.

# --- Flare ---
FLARE_API_KEY=
FLARE_TENANT_ID=
# FLARE_BASE_URL=https://api.flare.io
# FLARE_MIN_SEVERITY=low            # filtre côté API (>=)
# FLARE_EVENT_TYPES=                # ex. leak,stealer_log,ransomleak
# FLARE_FETCH_DETAILS=true          # 1 appel détail par événement

# --- JIRA Cloud ---
JIRA_DRY_RUN=true                   # true = rien n'est envoyé, tickets écrits dans data/jira_dry_run.jsonl
JIRA_BASE_URL=https://votre-instance.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CTI
JIRA_ISSUE_TYPE=Task

# --- Local ---
CTI_STATE_DB=data/state.sqlite
# CTI_TRIAGE_CONFIG=config/triage.toml
